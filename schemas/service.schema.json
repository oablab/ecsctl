{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ecsctl Service Spec",
  "description": "Declarative service definition for ecsctl apply",
  "type": "object",
  "required": ["metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "ecsctl/v1"
    },
    "kind": {
      "type": "string",
      "const": "Service"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "cluster"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Service name (also used as task definition family and alias)"
        },
        "cluster": {
          "type": "string",
          "description": "ECS cluster name"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["image", "cpu", "memory"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "description": "Container image (e.g. nginx:latest, 123456.dkr.ecr.us-east-1.amazonaws.com/app:v1)"
        },
        "cpu": {
          "type": "string",
          "enum": ["256", "512", "1024", "2048", "4096"],
          "description": "Task CPU units (256=0.25vCPU, 512=0.5, 1024=1, 2048=2, 4096=4)"
        },
        "memory": {
          "type": "string",
          "enum": ["512", "1024", "2048", "3072", "4096", "5120", "6144", "7168", "8192", "9216", "10240", "11264", "12288", "13312", "14336", "15360", "16384", "17408", "18432", "19456", "20480", "21504", "22528", "23552", "24576", "25600", "26624", "27648", "28672", "29696", "30720"],
          "description": "Task memory in MB (must be valid for chosen cpu)"
        },
        "arch": {
          "type": "string",
          "enum": ["X86_64", "ARM64"],
          "default": "X86_64",
          "description": "CPU architecture"
        },
        "capacity": {
          "type": "string",
          "enum": ["FARGATE", "FARGATE_SPOT"],
          "default": "FARGATE",
          "description": "Capacity provider"
        },
        "desiredCount": {
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "description": "Number of tasks to run"
        },
        "execEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable ECS Exec (requires task role with SSM permissions)"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0,
          "description": "Container port to expose (0 = none)"
        },
        "containerName": {
          "type": "string",
          "default": "app",
          "description": "Container name in the task definition"
        },
        "command": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Override container command (e.g. [\"sh\", \"-c\", \"exec ...\"])"
        },
        "executionRoleArn": {
          "type": "string",
          "pattern": "^arn:aws:iam::",
          "description": "Task execution role ARN (for pulling images, logging)"
        },
        "taskRoleArn": {
          "type": "string",
          "pattern": "^arn:aws:iam::",
          "description": "Task role ARN (permissions for the running container)"
        },
        "subnets": {
          "type": "array",
          "items": { "type": "string", "pattern": "^subnet-" },
          "description": "VPC subnet IDs"
        },
        "securityGroups": {
          "type": "array",
          "items": { "type": "string", "pattern": "^sg-" },
          "description": "Security group IDs"
        },
        "assignPublicIp": {
          "type": "boolean",
          "default": false,
          "description": "Assign a public IP to the task ENI"
        },
        "logGroup": {
          "type": "string",
          "description": "CloudWatch Logs group name (e.g. /ecs/my-app)"
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Environment variables (key: value)"
        },
        "secrets": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Secrets from SSM/SecretsManager (key: ARN)"
        },
        "containers": {
          "type": "array",
          "description": "Multi-container task definition (sidecars). When present, image/port/command/entryPoint/env/secrets/logGroup/containerName at the spec level are ignored in favor of this list.",
          "items": {
            "type": "object",
            "required": ["name", "image"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "description": "Container name (used by dependsOn and mountPoints)" },
              "image": { "type": "string" },
              "essential": { "type": "boolean", "default": true },
              "port": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 0 },
              "command": { "type": "array", "items": { "type": "string" } },
              "entryPoint": { "type": "array", "items": { "type": "string" }, "description": "Override the image's ENTRYPOINT" },
              "env": { "type": "object", "additionalProperties": { "type": "string" } },
              "secrets": { "type": "object", "additionalProperties": { "type": "string" } },
              "logGroup": { "type": "string" },
              "user": { "type": "string", "description": "Container user override, e.g. \"0\" for root or \"1000\" for a fixed uid" },
              "readonlyRootFilesystem": { "type": "boolean", "default": false },
              "dependsOn": {
                "type": "array",
                "description": "Startup ordering against other containers in this task. HEALTHY parses (so the tool can explain why it is refused rather than emitting a generic unknown-value error) but is rejected at validation time: it requires a healthCheck this schema cannot configure. SUCCESS/COMPLETE additionally require the *target* container (named in containerName) to have essential: false -- AWS rejects a SUCCESS/COMPLETE dependency on an essential container.",
                "items": {
                  "type": "object",
                  "required": ["containerName", "condition"],
                  "additionalProperties": false,
                  "properties": {
                    "containerName": { "type": "string" },
                    "condition": { "type": "string", "enum": ["START", "SUCCESS", "COMPLETE", "HEALTHY"] }
                  }
                }
              },
              "linuxParameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "capabilitiesDrop": {
                    "type": "array",
                    "items": { "type": "string", "enum": ["ALL", "AUDIT_CONTROL", "AUDIT_WRITE", "BLOCK_SUSPEND", "CHOWN", "DAC_OVERRIDE", "DAC_READ_SEARCH", "FOWNER", "FSETID", "IPC_LOCK", "IPC_OWNER", "KILL", "LEASE", "LINUX_IMMUTABLE", "MAC_ADMIN", "MAC_OVERRIDE", "MKNOD", "NET_ADMIN", "NET_BIND_SERVICE", "NET_BROADCAST", "NET_RAW", "SETFCAP", "SETGID", "SETPCAP", "SETUID", "SYS_ADMIN", "SYS_BOOT", "SYS_CHROOT", "SYS_MODULE", "SYS_NICE", "SYS_PACCT", "SYS_PTRACE", "SYS_RAWIO", "SYS_RESOURCE", "SYS_TIME", "SYS_TTY_CONFIG", "SYSLOG", "WAKE_ALARM"] },
                    "description": "Linux capabilities to drop, validated against the ECS-accepted set"
                  }
                }
              },
              "mountPoints": {
                "type": "object",
                "description": "containerPath -> sourceVolume. Value is either the volume name (read-write) or an object with sourceVolume and readOnly.",
                "additionalProperties": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["sourceVolume"],
                      "additionalProperties": false,
                      "properties": {
                        "sourceVolume": { "type": "string" },
                        "readOnly": { "type": "boolean", "default": false }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "volumes": {
          "type": "array",
          "description": "Task-level volumes, referenced by name from each container's mountPoints. Omit efs for ephemeral ECS-managed scratch storage. EBS (configuredAtLaunch) is deliberately unsupported: the task definition flag is only half of an attachment and this tool does not send volumeConfigurations on Create/UpdateService.",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "efs": {
                "type": "object",
                "required": ["fileSystemId"],
                "additionalProperties": false,
                "description": "EFS is the only non-ephemeral volume type usable on Fargate; host and Docker volumes are EC2-only",
                "properties": {
                  "fileSystemId": { "type": "string" },
                  "rootDirectory": { "type": "string" },
                  "transitEncryption": { "type": "string", "enum": ["ENABLED", "DISABLED"] },
                  "accessPointId": { "type": "string" },
                  "iam": { "type": "string", "enum": ["ENABLED", "DISABLED"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
